# Server (NODE_ENV and PORT are required at startup)
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Groq API (optional) — https://console.groq.com — powers POST /ai/generate-message
GROQ_API_KEY=

# PostgreSQL (Supabase: use pooler connection string with sslmode=require)
# Docker Compose maps Postgres to host port 5433 (see docker-compose.yml). Use 5432 only if no port conflict.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/revora

# Redis (Railway Redis plugin or Upstash)
# Docker Compose maps Redis to host port 6380 (see docker-compose.yml). Use 6379 only if no conflict.
REDIS_URL=redis://localhost:6380

# Phase 1 defaults (used when per-user JSON config + headers omit values)
DEFAULT_AOV_INR=350
RESPONSE_THRESHOLD_SECONDS=300

# After N inbound messages for a user, enqueue the first 14-day report once (default 10)
FIRST_REPORT_INCOMING_MESSAGE_THRESHOLD=10

# Test API: enables POST /api/test/simulate-inbound (keep false in production)
TEST_MODE=false
ALLOW_TEST_SIMULATE_API=false

# When set, /api/leads and /api/metrics require header: X-Admin-Key: <same value>
ADMIN_API_KEY=

# BullMQ: how often to scan leads due for follow-up (ms, default 5 minutes)
LEAD_FOLLOWUP_SCAN_INTERVAL_MS=300000

# Meta WhatsApp Cloud API (Graph) — required for outbound sends and dev /dev/send-whatsapp
WHATSAPP_TOKEN=
# Phone Number ID from Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Graph version for https://graph.facebook.com/{version}/{phone-number-id}/messages (default v18.0)
WHATSAPP_API_VERSION=v18.0

# Meta webhook: GET /webhook/whatsapp verification (Subscribe) — must match exactly in Meta “Verify token”
WEBHOOK_VERIFY_TOKEN=

# WhatsApp / 360dialog webhook HMAC — Meta App Secret style (raw body, hex digest)
# Set the same secret Meta shows for your WhatsApp app, OR a shared secret your proxy signs with.
WEBHOOK_APP_SECRET=
# Back-compat alias (optional)
DIALOG360_WEBHOOK_SECRET=

# 360dialog Client API (outbound d360-api-key; optional until you send messages)
THREESIXTY_DIALOG_API_KEY=
# Partner API (optional; reserved for future integrations)
THREESIXTY_DIALOG_PARTNER_TOKEN=

# Development only: skip HMAC (NEVER in production)
WEBHOOK_SKIP_SIGNATURE_VERIFY=true
# Allow { simulate: true } without signature when verify is on (disable in strict prod if desired)
WEBHOOK_ALLOW_SIMULATE_WITHOUT_SIGNATURE=true

# Owner WhatsApp number when Cloud payloads omit explicit business line.
DEFAULT_BUSINESS_PHONE=

# Queues
QUEUE_MAX_ATTEMPTS=8
QUEUE_BACKOFF_MS=2000

# Conversation lock + webhook idempotency (Redis TTL seconds)
CONVERSATION_LOCK_TTL_SECONDS=45
IDEMPOTENCY_WA_TTL_SECONDS=172800

# Rate limits (per IP; Redis-backed)
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=2000

# Postgres TLS
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
